# Editor support: `make merlin` writes a .merlin file in each source
# directory, so that merlin and ocaml-lsp-server work on the compiler
# sources. See "Using merlin" in HACKING.adoc.
#
# Merlin can only read the .cmi and .cmt files of the OCaml version it was
# built for, which is usually not the version of this tree. Two modes:
#
#  - shadow: type-check the sources with the host compiler $(MERLIN_OCAMLC),
#    the one merlin was built with, into $(MERLIN_DIR), and point merlin
#    there. This does not touch the real build.
#  - build: point merlin at the artefacts of the real build. This only works
#    when the host compiler has the same .cmi format as this tree, for
#    instance on a release branch, and after `make`.
#
# The mode is chosen by comparing the .cmi magic numbers, or can be forced
# with MERLIN_MODE=shadow or MERLIN_MODE=build.

MERLIN_OCAMLC ?= ocamlc
MERLIN_OCAMLLEX ?= ocamllex
MERLIN_OCAMLYACC ?= ocamlyacc
# Optional: without ocaml-index, find-references only searches the current
# file.
MERLIN_OCAML_INDEX ?= $(shell command -v ocaml-index 2>/dev/null)
MERLIN_DIR = _merlin

# Directories covered by .depend, built with the default rules of Makefile.
# toplevel/native and otherlibs/dynlink are not covered yet: they need
# Dynlink, which is built from copies of compiler modules.
MERLIN_ROOT_DIRS = \
  $(filter-out runtime otherlibs/%,$(VPATH)) \
  toplevel/byte lex debugger ocamldoc ocamltest

MERLIN_OTHERLIBS = unix str runtime_events systhreads

MERLIN_DIRS = \
  stdlib $(addprefix otherlibs/,$(MERLIN_OTHERLIBS)) $(MERLIN_ROOT_DIRS)

# Units of .depend that the real build does not compile on its own:
# fragments of utils/config.ml, copies of it for the boot cycle, the entry
# point of the packed debugger, and a tool that is currently broken.
MERLIN_EXCLUDE = \
  $(addprefix utils/config,.common .fixed .generated _main _boot) \
  debugger/ocamldebug_entry tools/lintapidiff

# $(call merlin_compflags,dir): the flags of the real build for dir.
# stdlib and otherlibs have their own Makefile, which is asked directly.
merlin_compflags = $(strip \
  $(if $(filter stdlib otherlibs/%,$(1)), \
    $(shell $(MAKE) -s --no-print-directory -C $(1) \
      --eval 'merlin-compflags: ; @echo $$(COMPFLAGS)' merlin-compflags), \
    $(OC_COMMON_COMPFLAGS)))

# -warn-error is only enforced by the real build: the host compiler may
# warn about things the compiler of this tree accepts.
# -bin-annot-occurrences records the uses of names in the .cmt files, from
# which ocaml-index builds the index used to find references.
merlin_shadow_flags = \
  $(call merlin_compflags,$(1)) -warn-error -a -bin-annot-occurrences
merlin_flags = \
  $(filter-out -bin-annot -absname -nostdlib,$(call merlin_compflags,$(1))) \
  -nostdlib

# Sources generated by the real build that do not need a compiler.
# The shadow build generates the others itself with the host tools:
# lexers and parsers, bytecomp/opcodes.mli (with ocamlc -i), and
# parsing/parser.ml (which depends on compiled interfaces in .depend.menhir).
MERLIN_GENERATED_SOURCES = \
  utils/config.ml utils/domainstate.ml utils/domainstate.mli \
  parsing/camlinternalMenhirLib.ml parsing/camlinternalMenhirLib.mli \
  bytecomp/opcodes.ml bytecomp/opnames.ml \
  lambda/runtimedef.ml $(ARCH_SPECIFIC)

MERLIN_HOST_MAGIC = \
  $(shell $(MERLIN_OCAMLC) -config-var cmi_magic_number 2>/dev/null)
MERLIN_TREE_MAGIC = \
  $(shell sed -n 's/.*cmi_magic_number = {magic|\([^|]*\)|magic}.*/\1/p' \
            utils/config.common.ml)

MERLIN_MODE ?= \
  $(if $(filter $(MERLIN_TREE_MAGIC),$(MERLIN_HOST_MAGIC)),build,shadow)

# The magic numbers are only computed when `make merlin` runs.
.PHONY: merlin
merlin:
	@$(MAKE) --no-print-directory merlin-$(strip $(MERLIN_MODE))

# $(call merlin_up,dir): relative path from dir back to the root
merlin_up = $(subst $(SPACE),,$(patsubst %,../,$(subst /, ,$(1))))

# $(call merlin_paths,dir): directories to look into for dir, in the order
# of the -I flags of the real build
merlin_paths = $(strip \
  $(if $(filter stdlib,$(1)),stdlib, \
  $(if $(filter otherlibs/%,$(1)),$(1) otherlibs/unix stdlib, \
  $(1) $(filter-out runtime,$(VPATH)) stdlib)))

# $(call merlin_file,dir,source dirs,build dirs,index files)
# Note that dot-merlin-reader stops at the first empty line.
# Locations in the indexes are relative to the root (SOURCE_ROOT).
# The first build dir, the one of dir itself, is repeated at the end: merlin
# 5.9 gives precedence to the last B directive, unlike -I for the compiler,
# and lex/parser.cmi must win over parsing/parser.cmi in lex/, for instance.
define merlin_file
	$(MERLIN_Q)$(if $(filter 0,$(V)),echo '  GEN $(1)/.merlin';)( \
	  echo 'EXCLUDE_QUERY_DIR'; \
	  $(foreach d,$(2),echo 'S $(call merlin_up,$(1))$(d)';) \
	  $(foreach d,$(3) $(firstword $(3)), \
	    echo 'B $(call merlin_up,$(1))$(d)';) \
	  $(foreach f,$(4),echo 'INDEX $(call merlin_up,$(1))$(f)';) \
	  $(if $(4),echo 'SOURCE_ROOT $(call merlin_up,$(1))';) \
	  echo 'FLG $(call merlin_flags,$(1))'; \
	  $(if $(filter stdlib,$(1)),echo 'WRAPPING_PREFIX Stdlib__';) \
	) > $(1)/.merlin
endef

.PHONY: merlin-build
merlin-build:
	@test -f utils/misc.cmi || \
	  echo "make merlin: run make first, merlin reads the build artefacts" >&2
	$(foreach d,$(MERLIN_DIRS), \
	  $(call merlin_file,$(d),$(call merlin_paths,$(d)), \
	    $(call merlin_paths,$(d)))$(NEWLINE))

MERLIN_Q = $(if $(filter 0,$(V)),@)

MERLIN_SHADOW = $(MAKE) --no-print-directory \
  -f $(CURDIR)/Makefile.merlin-shadow AWK='$(AWK)' ARCH='$(ARCH)' \
  MERLIN_OCAMLC='$(MERLIN_OCAMLC)' MERLIN_OCAMLLEX='$(MERLIN_OCAMLLEX)' \
  MERLIN_OCAMLYACC='$(MERLIN_OCAMLYACC)' \
  MERLIN_OCAML_INDEX='$(MERLIN_OCAML_INDEX)'

# The shadow builds write an index per library, and per directory of
# $(MERLIN_ROOT_DIRS), see Makefile.merlin-shadow. Every .merlin lists all
# of them, so that references are found across the whole tree.
MERLIN_INDEX_FILES = $(if $(MERLIN_OCAML_INDEX), \
  $(addsuffix /merlin.ocaml-index,$(addprefix $(MERLIN_DIR)/,$(MERLIN_DIRS))))

# Interface errors in the standard library stop the build, since nothing
# else could be type-checked. Elsewhere, errors are reported and skipped.
.PHONY: merlin-shadow
merlin-shadow: $(MERLIN_GENERATED_SOURCES)
	@test -n "$(MERLIN_HOST_MAGIC)" || { \
	  echo "make merlin: cannot run $(MERLIN_OCAMLC), set MERLIN_OCAMLC" >&2; \
	  exit 1; }
	@test -n "$(MERLIN_OCAML_INDEX)" || \
	  echo "make merlin: ocaml-index not found, find-references will only" \
	       "search the current file (set MERLIN_OCAML_INDEX)" >&2
# The debugger and ocamldoc only need the interface of Dynlink, which the
# shadow build of $(MERLIN_ROOT_DIRS) compiles on demand.
	@mkdir -p $(addprefix $(MERLIN_DIR)/, \
	  stdlib $(addprefix otherlibs/,$(MERLIN_OTHERLIBS) dynlink))
	$(MERLIN_Q)+$(MERLIN_SHADOW) -C $(MERLIN_DIR)/stdlib \
	  ROOT=../.. SHADOW=$(MERLIN_DIR)/stdlib \
	  SRCDIR=../../stdlib DEPEND=.depend STDLIB=true \
	  COMPFLAGS='$(call merlin_shadow_flags,stdlib)' \
	  PERFILE_FLAGS=../../stdlib/Compflags
	$(MERLIN_Q)+$(foreach l,$(MERLIN_OTHERLIBS), \
	  $(MERLIN_SHADOW) -k -C $(MERLIN_DIR)/otherlibs/$(l) \
	    ROOT=../../.. SHADOW=$(MERLIN_DIR)/otherlibs/$(l) \
	    SRCDIR=../../../otherlibs/$(l) DEPEND=.depend \
	    COMPFLAGS='$(call merlin_shadow_flags,otherlibs/$(l))' \
	    INCLUDE_DIRS='../../stdlib ../unix' || true;)
	$(MERLIN_Q)+$(MERLIN_SHADOW) -k -C $(MERLIN_DIR) \
	  ROOT=.. SHADOW=$(MERLIN_DIR) \
	  SRCDIR=.. DEPEND='.depend .depend.menhir' \
	  DIRS='$(MERLIN_ROOT_DIRS)' EXCLUDE='$(MERLIN_EXCLUDE)' \
	  COMPFLAGS='$(call merlin_shadow_flags,.)' \
	  INCLUDE_DIRS='$(VPATH) stdlib' \
	  || true
	$(foreach d,$(MERLIN_DIRS), \
	  $(call merlin_file,$(d),$(call merlin_paths,$(d)) $(MERLIN_DIR)/$(d), \
	    $(addprefix $(MERLIN_DIR)/,$(call merlin_paths,$(d))), \
	    $(MERLIN_INDEX_FILES))$(NEWLINE))

.PHONY: clean-merlin
clean-merlin:
	rm -rf $(MERLIN_DIR)
	rm -f $(addsuffix /.merlin,$(MERLIN_DIRS))

distclean: clean-merlin
